# 3. PLOT IGV CURVES
# ---------------------------------------------------------
special_lines = ['Surge', 'Choke', 'Anti Surge']
igv_values = [v for v in df_curves['IGV'].unique() if v not in special_lines]

for igv in igv_values:
    subset = df_curves[df_curves['IGV'] == igv]
    ax.plot(subset['Q3_normal(nm3/hr)_corrected'], subset['CorrectedHeadbara'], 
