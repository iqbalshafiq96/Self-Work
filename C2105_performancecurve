# 4. PLOT SPECIAL LINES
# ---------------------------------------------------------
for special in special_lines:
    subset = df_curves[df_curves['IGV'] == special]
    if not subset.empty:
        style = '--' if special == 'Surge' else ':' if special == 'Anti Surge' else '-.'
        color = 'red' if 'Surge' in special else 'black'
        ax.plot(subset['Q3_normal(nm3/hr)_corrected'], subset['CorrectedHeadbara'], 
                linestyle=style, color=color, linewidth=2, label=special)

# 5. PLOT MEASURED FLOW DATA & 2D IGV INTERPOLATED PREDICTED POINTS
# ---------------------------------------------------------
# Updated formatting: Blue markers for Measured flow
ax.scatter(dataset['FlowNormalized'], 
           dataset['Corrected Pressure (barA)'], 
           color='#0047AB', s=10, marker='o', 
           edgecolors='white', linewidth=0.2, alpha=0.5,
           label='Measured flow (F21054DIF)', zorder=4)

interpolated_legend_added = False

# Base arrays tracking curve values from 0 to 75 degrees
base_igvs = np.array([0, 30, 40, 50, 60, 75])

# Fixed name string reference mapping to match Power BI's internal parsing 
igv_col_name = 'IGV21054 IGV.value'

for idx, row in dataset.iterrows():
    op_pressure = row['Corrected Pressure (barA)']
    op_igv_val = row[igv_col_name] if igv_col_name in dataset.columns else np.nan
    
    if pd.notna(op_igv_val) and pd.notna(op_pressure):
        flows_at_pressure = []
        valid_igvs = []
        
        # Calculate expected Flow for every baseline curve boundary at current discharge pressure
        for deg in base_igvs:
            curve_subset = df_curves[df_curves['IGV'] == f"{deg}°"]
            x_curve = curve_subset['Q3_normal(nm3/hr)_corrected'].values
            y_curve = curve_subset['CorrectedHeadbara'].values
            
            # Sort arrays by Y dimension to ensure interpolation matches valid monotonically increasing pressure trend
            sort_idx = np.argsort(y_curve)
            y_sort = y_curve[sort_idx]
            x_sort = x_curve[sort_idx]
            
            if y_sort.min() <= op_pressure <= y_sort.max():
                interp_flow_func = interp1d(y_sort, x_sort, kind='linear', fill_value="extrapolate")
                flows_at_pressure.append(float(interp_flow_func(op_pressure)))
                valid_igvs.append(deg)
                
        # Interpolate across the 0° to 75° degree spectrum to isolate individual precise target flow coordinate
        if len(valid_igvs) >= 2:
            valid_igvs = np.array(valid_igvs)
            flows_at_pressure = np.array(flows_at_pressure)
            
            deg_sort_idx = np.argsort(valid_igvs)
            valid_igvs = valid_igvs[deg_sort_idx]
            flows_at_pressure = flows_at_pressure[deg_sort_idx]
            
            if valid_igvs.min() <= op_igv_val <= valid_igvs.max():
                interp_target_func = interp1d(valid_igvs, flows_at_pressure, kind='linear')
                target_flow = float(interp_target_func(op_igv_val))
                
                lbl = 'Predicted flow (Actual IGV)' if not interpolated_legend_added else ""
                interpolated_legend_added = True
                
                # Updated formatting: Red 'x' markers for Predicted flow
                ax.scatter(target_flow, op_pressure, 
                           color='red', s=12, marker='x', 
                           linewidth=0.8, alpha=0.7,
                           label=lbl, zorder=5)

