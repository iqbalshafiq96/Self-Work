df_curves = pd.DataFrame(data).sort_values(by=['IGV', 'Q3_normal(nm3/hr)_corrected'])

# 2. EXACT DIMENSION MAPPING (566w x 558h pixels)
# ---------------------------------------------------------
px_w, px_h = 566, 558
