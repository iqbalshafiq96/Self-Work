# ==============================================================================
# INTERPOLATION ENGINE
# ==============================================================================
def interpolate_flow(target_deg, target_y):
    if pd.isna(target_deg) or pd.isna(target_y):
        return np.nan
        
    unique_degs = sorted(df_map['deg_num'].dropna().unique())
    x_at_degs = []
    valid_degs = []
    
    for d in unique_degs:
        sub = df_map[df_map['deg_num'] == d].sort_values(by='y')
        if sub['y'].min() <= target_y <= sub['y'].max():
            f_interp = interp1d(sub['y'], sub['x'], bounds_error=False, fill_value="extrapolate")
            x_at_degs.append(float(f_interp(target_y)))
            valid_degs.append(d)
            
    if len(valid_degs) < 2:
        return np.nan
        
    f_final = interp1d(valid_degs, x_at_degs, bounds_error=False, fill_value="extrapolate")
    return float(f_final(target_deg))

